---
interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const navLinks = [
  { name: "首页", href: "/" },
  { name: "机场推荐", href: "/recommend/budget/" },
  { name: "综合排行", href: "/ranking/overall/" },
  { name: "机场评测", href: "/review/breezenet/" },
  { name: "在线对比", href: "/compare/" },
  { name: "教程中心", href: "/guides/" },
  { name: "深度博客", href: "/blog/" },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-white/90 border-b border-slate-200/80 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
          <span class="text-xl">⚡</span>
        </div>
        <div>
          <div class="text-lg font-extrabold tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">
            十代梯子
          </div>
          <div class="text-[10px] tracking-wider font-semibold text-slate-400 uppercase -mt-1">
            shidatizi.co
          </div>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navLinks.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-lg text-sm font-semibold transition-all ${
                isActive
                  ? "bg-blue-50 text-blue-600 shadow-sm shadow-blue-500/10"
                  : "text-slate-600 hover:text-slate-900 hover:bg-slate-100/70"
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Right Action CTA (包含用户红框要求的“联络我们”及 Gmail/Telegram 直达) -->
      <div class="hidden sm:flex items-center gap-2.5">
        <!-- 联络我们 专业下拉卡片 -->
        <div class="relative group" id="contact-dropdown-container">
          <button
            type="button"
            id="contact-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-blue-700 bg-blue-50/90 border border-blue-200 hover:bg-blue-100 hover:border-blue-300 transition-all shadow-xs cursor-pointer"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span class="text-xs">💬</span>
            <span>联络我们</span>
            <svg class="w-3.5 h-3.5 text-blue-500 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown Popover Card (专业联系方式浮窗) -->
          <div
            id="contact-dropdown"
            class="hidden group-hover:block absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-2xl border border-slate-200 shadow-2xl p-4 sm:p-5 z-50 text-left transition-all"
          >
            <!-- Dropdown Header -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-xs font-bold text-slate-800">官方商务与技术直通通道</span>
              </div>
              <span class="text-[11px] font-semibold text-slate-400">24小时内极速响应</span>
            </div>

            <p class="text-xs text-slate-500 mb-4 leading-relaxed">
              欢迎机场服务商申请数据入驻/信息纠错、品牌评测合作，或读者提供技术体验反馈：
            </p>

            <div class="space-y-3">
              <!-- Gmail Card -->
              <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 hover:border-blue-200 transition-colors">
                <div class="flex items-center justify-between mb-1.5">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-lg bg-red-100 text-red-600 flex items-center justify-center text-xs font-bold">
                      ✉️
                    </div>
                    <span class="text-xs font-bold text-slate-900">Gmail 官方商务邮箱</span>
                  </div>
                  <span class="text-[10px] text-slate-400">商务合作 / 评测入驻</span>
                </div>
                <div class="flex items-center justify-between gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-mono text-slate-800">
                  <span class="truncate select-all font-semibold">xintangtang888@gmail.com</span>
                  <div class="flex items-center gap-1 shrink-0">
                    <button
                      type="button"
                      class="px-2 py-0.5 text-[11px] font-bold text-slate-600 hover:text-blue-600 hover:bg-slate-100 rounded transition-colors copy-btn"
                      data-copy="xintangtang888@gmail.com"
                      data-label="邮箱"
                    >
                      复制
                    </button>
                    <a
                      href="mailto:xintangtang888@gmail.com"
                      class="px-2 py-0.5 text-[11px] font-bold text-white bg-blue-600 hover:bg-blue-700 rounded transition-colors"
                    >
                      发送
                    </a>
                  </div>
                </div>
              </div>

              <!-- Telegram Card -->
              <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 hover:border-sky-200 transition-colors">
                <div class="flex items-center justify-between mb-1.5">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-lg bg-sky-100 text-sky-600 flex items-center justify-center text-xs font-bold">
                      ✈️
                    </div>
                    <span class="text-xs font-bold text-slate-900">Telegram 官方直通客服</span>
                  </div>
                  <span class="text-[10px] text-emerald-600 font-semibold">在线即时沟通</span>
                </div>
                <div class="flex items-center justify-between gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs font-mono text-slate-800">
                  <span class="truncate select-all font-semibold text-sky-700">@xintangtang</span>
                  <div class="flex items-center gap-1 shrink-0">
                    <button
                      type="button"
                      class="px-2 py-0.5 text-[11px] font-bold text-slate-600 hover:text-sky-600 hover:bg-slate-100 rounded transition-colors copy-btn"
                      data-copy="@xintangtang"
                      data-label="Telegram"
                    >
                      复制
                    </button>
                    <a
                      href="https://t.me/xintangtang"
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="px-2 py-0.5 text-[11px] font-bold text-white bg-sky-500 hover:bg-sky-600 rounded transition-colors"
                    >
                      直达
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Footer note -->
            <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
              <span>技术中立核验 · 拒绝虚假刷榜</span>
              <a href="/contact/" class="text-blue-600 hover:underline font-bold">详细联络指南 →</a>
            </div>
          </div>
        </div>

        <a
          href="/compare/"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200/70 transition-colors"
        >
          <span>⚖️</span>
          <span>参数对比</span>
        </a>
        <a
          href="/ranking/overall/"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-md shadow-blue-500/25 transition-all"
        >
          <span>🏆</span>
          <span>2026综合榜</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
          aria-label="切换菜单"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white/95 px-4 pt-2 pb-4 space-y-1">
    {navLinks.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:text-blue-600 hover:bg-blue-50 transition-colors"
      >
        {item.name}
      </a>
    ))}

    <!-- Mobile Contact Box -->
    <div class="p-3 my-2 rounded-xl bg-blue-50/60 border border-blue-100 text-xs">
      <div class="font-bold text-slate-800 mb-2 flex items-center gap-1.5">
        <span>💬 官方联络方式</span>
      </div>
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-slate-600">
          <span>Gmail:</span>
          <a href="mailto:xintangtang888@gmail.com" class="font-mono text-blue-600 font-bold">xintangtang888@gmail.com</a>
        </div>
        <div class="flex items-center justify-between text-slate-600">
          <span>Telegram:</span>
          <a href="https://t.me/xintangtang" target="_blank" rel="noopener noreferrer nofollow" class="font-mono text-sky-600 font-bold">@xintangtang</a>
        </div>
      </div>
    </div>

    <div class="pt-3 border-t border-slate-100 flex gap-2">
      <a href="/compare/" class="flex-1 text-center py-2 text-xs font-bold bg-slate-100 text-slate-700 rounded-lg">
        ⚖️ 在线对比
      </a>
      <a href="/ranking/overall/" class="flex-1 text-center py-2 text-xs font-bold bg-blue-600 text-white rounded-lg">
        🏆 综合榜单
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Desktop contact dropdown click toggle
  const contactBtn = document.getElementById('contact-btn');
  const contactDropdown = document.getElementById('contact-dropdown');
  const contactContainer = document.getElementById('contact-dropdown-container');

  if (contactBtn && contactDropdown && contactContainer) {
    contactBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      contactDropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!contactContainer.contains(e.target as Node)) {
        contactDropdown.classList.add('hidden');
      }
    });
  }

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const text = btn.getAttribute('data-copy');
      const label = btn.getAttribute('data-label') || '';
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          const originalText = btn.textContent;
          btn.textContent = '已复制!';
          btn.classList.add('text-emerald-600', 'font-bold');
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove('text-emerald-600', 'font-bold');
          }, 2000);
        }).catch(() => {
          prompt('请复制以下内容：', text);
        });
      }
    });
  });
</script>
