---
import { allAirports } from '../data/index.js';

const topAirport = allAirports[0]; // 微风网络 Breezenet
---

<section class="relative overflow-hidden bg-gradient-to-b from-blue-900 via-slate-900 to-slate-950 text-white py-12 lg:py-16">
  <!-- Subtle Grid Background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:32px_32px]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Pill -->
    <div class="flex items-center gap-2 mb-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-500/20 text-blue-300 border border-blue-400/30">
        <span>⚡</span>
        <span>2026 Bing SEO 权威中文资讯门户 · 独立技术抽检</span>
      </span>
      <span class="hidden sm:inline-block text-xs text-slate-400">核验时间：2026年3月</span>
    </div>

    <!-- H1 Headline -->
    <div class="max-w-6xl mb-8">
      <h1 class="text-2xl sm:text-3xl md:text-4xl xl:text-[2.6rem] font-black tracking-tight leading-normal sm:leading-snug mb-4">
        <span class="inline-block">2026 优质机场推荐与 VPN 梯子节点评测指南</span>
        <span class="hidden md:inline-block text-blue-400/80 mx-2 font-normal">·</span>
        <span class="inline-block text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-indigo-300">
          性价比与晚高峰稳定翻墙节点全景排行
        </span>
      </h1>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-4xl">
        面对鱼龙混杂的翻墙梯子服务，如何拒绝虚假测速与暗扣流量套路？<strong>十代梯子 (shidatizi.co)</strong> 坚持技术中立，提供真实单 GB 成本测算、晚高峰丢包核验与 14 大主流品牌横向参数比对。
      </p>
    </div>

    <!-- Dual Layout: Spotlight Card + News Bulletin Feed -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      <!-- Left: 主编特写 (Featured Spotlight 60%) -->
      <div class="lg:col-span-7 bg-slate-800/80 backdrop-blur-md rounded-2xl border border-blue-500/30 p-6 sm:p-8 flex flex-col justify-between shadow-2xl shadow-blue-900/30 relative overflow-hidden group">
        <!-- Glow accent -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-blue-500/20 rounded-full blur-3xl pointer-events-none group-hover:bg-blue-500/30 transition-all"></div>

        <div>
          <div class="flex items-center justify-between gap-4 mb-4">
            <span class="px-2.5 py-1 rounded-md text-xs font-black bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 uppercase tracking-wider">
              ⭐ 2026 年度综合总榜冠军
            </span>
            <span class="text-xs font-bold text-emerald-400 flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              SLA {topAirport.sla} 在线可用
            </span>
          </div>

          <div class="flex flex-wrap items-baseline gap-3 mb-2">
            <h2 class="text-2xl sm:text-3xl font-black text-white">
              {topAirport.name}
            </h2>
            <span class="text-xs text-blue-300 font-semibold bg-blue-950/80 px-2 py-0.5 rounded border border-blue-800">
              {topAirport.lineType}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-slate-300 mb-6 leading-relaxed">
            {topAirport.description}
          </p>

          <!-- Core Data Specs -->
          <div class="grid grid-cols-3 gap-3 bg-slate-900/80 rounded-xl p-3.5 border border-slate-700/60 mb-6">
            <div>
              <div class="text-[11px] text-slate-400 mb-0.5">起步月付</div>
              <div class="text-lg font-black text-white">¥{topAirport.startingPrice} <span class="text-xs font-normal text-slate-400">/月</span></div>
            </div>
            <div>
              <div class="text-[11px] text-slate-400 mb-0.5">基础配额</div>
              <div class="text-lg font-black text-white">{topAirport.plans[0].bandwidthGB} <span class="text-xs font-normal text-slate-400">GB</span></div>
            </div>
            <div>
              <div class="text-[11px] text-slate-400 mb-0.5">折算每GB</div>
              <div class="text-lg font-black text-blue-400">¥{topAirport.plans[0].pricePerGB}</div>
            </div>
          </div>

          {topAirport.coupon && (
            <div class="flex items-center gap-2 text-xs bg-amber-400/10 border border-amber-400/30 text-amber-300 px-3 py-2 rounded-lg mb-6 font-semibold">
              <span>🎁 专属优惠券：</span>
              <code class="bg-amber-400/20 px-2 py-0.5 rounded text-amber-200 font-bold">{topAirport.coupon}</code>
              <span class="text-slate-400 text-[11px]">（结账立享折扣）</span>
            </div>
          )}
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={topAirport.affiliateUrl || topAirport.officialUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="flex-1 text-center py-2.5 px-4 rounded-xl text-sm font-bold text-white bg-blue-600 hover:bg-blue-500 shadow-lg shadow-blue-600/30 transition-all flex items-center justify-center gap-1.5"
          >
            <span>🚀 官网直达选购</span>
          </a>
          <a
            href={`/review/${topAirport.slug}/`}
            class="py-2.5 px-4 rounded-xl text-sm font-semibold text-slate-200 bg-slate-700/70 hover:bg-slate-700 hover:text-white transition-colors"
          >
            深度实测报告
          </a>
          <a
            href={`/airport/${topAirport.slug}/`}
            class="py-2.5 px-4 rounded-xl text-sm font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
          >
            资料库档案
          </a>
        </div>
      </div>

      <!-- Right: 即时技术资讯与高频快讯流 (Bulletin Feed 40%) -->
      <div class="lg:col-span-5 bg-slate-800/40 backdrop-blur-sm rounded-2xl border border-slate-700/60 p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-700/60">
            <div class="flex items-center gap-2">
              <span class="text-base">📡</span>
              <h3 class="text-sm font-black text-white uppercase tracking-wider">即时技术动态与行业快讯</h3>
            </div>
            <a href="/blog/" class="text-xs text-blue-400 hover:underline">查看全部 100 篇 →</a>
          </div>

          <div class="space-y-3.5">
            <div class="p-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 transition-colors border border-slate-700/40">
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                <span class="text-cyan-400 font-bold">晚高峰网络监测</span>
                <span>2026-03</span>
              </div>
              <a href="/blog/evening-peak-network-congestion-causes/" class="text-xs font-bold text-slate-100 hover:text-blue-400 line-clamp-1 transition-colors">
                每晚8点准时卡顿？揭秘国际出口晚高峰拥堵的物理真相
              </a>
              <p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">
                普通公网海缆超负荷丢包直线上升，纯IEPL专线无视高峰拥堵保障4K秒开。
              </p>
            </div>

            <div class="p-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 transition-colors border border-slate-700/40">
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                <span class="text-violet-400 font-bold">AI风控前沿</span>
                <span>2026-03</span>
              </div>
              <a href="/blog/claude-3-anthropic-clean-ip/" class="text-xs font-bold text-slate-100 hover:text-blue-400 line-clamp-1 transition-colors">
                Claude 3.7 注册即被秒封号？教你挑选 Anthropic 认证级纯净节点
              </a>
              <p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">
                公共数据中心IP极易被拦截，具备独立住宅IP的专线节点是避免降智的关键。
              </p>
            </div>

            <div class="p-3 rounded-xl bg-slate-800/60 hover:bg-slate-800 transition-colors border border-slate-700/40">
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
                <span class="text-amber-400 font-bold">行业避坑速递</span>
                <span>2026-03</span>
              </div>
              <a href="/blog/avoid-lifetime-plans/" class="text-xs font-bold text-slate-100 hover:text-blue-400 line-clamp-1 transition-colors">
                为什么坚决不碰“永久会员”与“终身不限时”机场套路？
              </a>
              <p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">
                没有终身免费的服务器带宽，坚持月付是保护自己资金安全的唯一铁律。
              </p>
            </div>
          </div>
        </div>

        <!-- Bottom Guide Entry -->
        <div class="mt-4 pt-3 border-t border-slate-700/60 flex items-center justify-between text-xs">
          <span class="text-slate-400">刚买机场不会配置？</span>
          <a href="/guides/" class="font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1">
            <span>查阅 30 篇保姆级教程中心</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
