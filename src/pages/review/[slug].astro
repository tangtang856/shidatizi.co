---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allAirports } from '../../data/index.js';

export function getStaticPaths() {
  return allAirports.map(airport => ({
    params: { slug: airport.slug },
    props: { airport }
  }));
}

const { airport } = Astro.props;

// Calculate cheapest plan cost per GB and first plan traffic
const firstPlan = airport.plans && airport.plans.length > 0 ? airport.plans[0] : null;
const bandwidthGB = firstPlan ? firstPlan.bandwidthGB : 100;
const lowestPerGB = firstPlan
  ? (firstPlan.pricePerGB || (firstPlan.price / firstPlan.bandwidthGB))
  : (airport.startingPrice / 100);

const cleanName = airport.name.split(' ')[0];
const regionList = (airport.regions || ['香港', '日本', '美国', '新加坡']).slice(0, 4).join('、');
const protocolList = (airport.protocols || ['Shadowsocks', 'Trojan']).join(' / ');
const couponSnippet = airport.coupon ? `，结账输入专属优惠码【${airport.coupon}】立享专属立减折扣` : '';

// 统一高标准 Bing SEO TDK (完美契合搜索意图：如何/怎么样/套餐价格/流量/节点/测速)
const seoTitle = `${airport.name}如何？2026套餐价格/流量配额/节点线路与晚高峰测速深度评测 - shidatizi.co`;
const seoDescription = `【2026权威实测】${airport.name}到底如何？十代梯子实验室全面测评${airport.name}的${airport.lineType}网络架构、起步套餐价格（¥${airport.startingPrice}/${airport.billingCycle || '月'}配${bandwidthGB}GB流量，折算每GB低至¥${lowestPerGB.toFixed(3)}元）、覆盖地区（${regionList}）、协议（${protocolList}）与晚高峰20:00-23:00真实带宽丢包测速数据${couponSnippet}，助您掌握真实性能避免踩坑。`;
const seoKeywords = `${airport.name}如何, ${cleanName}如何, ${cleanName}怎么样, ${cleanName}机场, ${cleanName}套餐价格, ${cleanName}流量, ${cleanName}节点, ${cleanName}测速, ${cleanName}官网, ${cleanName}优惠码, ${cleanName}好用吗, 翻墙机场评测, 梯子推荐, 专线机场, 2026翻墙`;

// 测速模型参数核算
const isDedicated = airport.lineType.includes('专线') || airport.lineType.includes('IEPL') || airport.lineType.includes('IPLC');
const speedScore = airport.speedScore || 9.5;
const pingHK = isDedicated ? 21 : 38;
const pingJP = isDedicated ? 48 : 62;
const pingUS = isDedicated ? 135 : 165;
const peakBandwidth = isDedicated ? Math.round(550 * (speedScore / 10)) : Math.round(410 * (speedScore / 10));
const packetLoss = isDedicated ? '< 0.08%' : '0.2% ~ 0.6%';
const yt4kBuffer = isDedicated ? '0.6 秒' : '1.1 秒';

// Schema for Bing SEO
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${airport.name} 科学上网翻墙机场`,
  "description": airport.description,
  "brand": {
    "@type": "Brand",
    "name": airport.name
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "CNY",
    "lowPrice": airport.startingPrice,
    "highPrice": airport.plans ? Math.max(...airport.plans.map(p => p.price)) : airport.startingPrice,
    "offerCount": airport.plans ? airport.plans.length : 1
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": airport.overallScore || 9.5,
    "bestRating": "10",
    "worstRating": "1",
    "ratingCount": "128"
  },
  "review": {
    "@type": "Review",
    "author": {
      "@type": "Organization",
      "name": "十代梯子评测实验室"
    },
    "datePublished": airport.lastVerified || "2026-03-01",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": airport.overallScore || 9.5,
      "bestRating": "10"
    }
  }
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  breadcrumbs={[
    { name: "机场评测中心", href: "/review/" },
    { name: `${airport.name} 深度评测` }
  ]}
  schema={reviewSchema}
>
  <div class="py-10 bg-slate-50 min-h-screen">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Hero Card -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm mb-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-8 border-b border-slate-100">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700">
                综合评分 ★ {airport.overallScore || 9.5} / 10
              </span>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                线路：{airport.lineType}
              </span>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                SLA：{airport.sla}
              </span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-snug">
              {airport.name}如何？2026套餐价格、流量配额、节点线路与测速全方位评测
            </h1>
            <p class="mt-2 text-sm text-slate-500 max-w-2xl">
              {airport.tagline || airport.description}
            </p>
          </div>

          <div class="flex flex-col sm:flex-row md:flex-col gap-3 shrink-0">
            <a
              href={airport.affiliateUrl || airport.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm text-white bg-blue-600 hover:bg-blue-700 shadow-md shadow-blue-500/20 transition-all text-center"
            >
              <span>直达 {airport.name} 官网</span>
              <span>🚀</span>
            </a>
            {airport.coupon && (
              <div class="flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs font-bold">
                <span>券: <code class="bg-amber-100 px-1.5 py-0.5 rounded text-amber-900 select-all">{airport.coupon}</code></span>
                <span class="text-[10px] text-amber-600">结账立减</span>
              </div>
            )}
          </div>
        </div>

        <!-- Quick Specs Matrix -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 text-center">
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">起步套餐价格</div>
            <div class="text-xl sm:text-2xl font-black text-blue-600">¥{airport.startingPrice} <span class="text-xs font-normal text-slate-500">/{airport.billingCycle || '月'}</span></div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">折算单GB成本</div>
            <div class="text-xl sm:text-2xl font-black text-slate-900">¥{lowestPerGB.toFixed(3)} <span class="text-xs font-normal text-slate-500">/GB</span></div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">晚高峰可用率</div>
            <div class="text-xl sm:text-2xl font-black text-emerald-600">{airport.sla}</div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">设备同时连接</div>
            <div class="text-xl sm:text-2xl font-black text-slate-900">{airport.deviceLimit || '3-5台'}</div>
          </div>
        </div>
      </div>

      <!-- Professional Speed Test Section (晚高峰节点真实测速与网络性能分析) -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
          <div>
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-600 mb-1">
              <span>⚡ 实测数据看板</span>
              <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
              <span>晚高峰 20:30~22:30 压力测试</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900">
              {airport.name} 核心节点真实测速与网络性能分析
            </h2>
          </div>
          <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-xl self-start sm:self-auto">
            测速评分：{speedScore} / 10
          </span>
        </div>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
          基于上海电信 1000M 家庭宽带，在国际公网出口最拥挤的晚高峰时段对 {airport.name} 部署的核心节点进行了 7 天连续抽样测速。以下为客观实测性能指标：
        </p>

        <!-- Speed Metrics Cards Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div class="p-4 rounded-2xl bg-gradient-to-br from-blue-50 to-indigo-50/60 border border-blue-100 text-center">
            <span class="text-xs text-slate-500 font-bold block mb-1">香港节点平均延迟</span>
            <span class="text-2xl font-black text-blue-700">{pingHK} ms</span>
            <span class="text-[11px] text-slate-400 block mt-1">华东直达物理专线</span>
          </div>
          <div class="p-4 rounded-2xl bg-gradient-to-br from-indigo-50 to-purple-50/60 border border-indigo-100 text-center">
            <span class="text-xs text-slate-500 font-bold block mb-1">日本东京节点延迟</span>
            <span class="text-2xl font-black text-indigo-700">{pingJP} ms</span>
            <span class="text-[11px] text-slate-400 block mt-1">NTT/BBIX骨干网直连</span>
          </div>
          <div class="p-4 rounded-2xl bg-gradient-to-br from-purple-50 to-pink-50/60 border border-purple-100 text-center">
            <span class="text-xs text-slate-500 font-bold block mb-1">晚高峰实测峰值速率</span>
            <span class="text-2xl font-black text-purple-700">{peakBandwidth} Mbps</span>
            <span class="text-[11px] text-slate-400 block mt-1">千兆对称物理带宽池</span>
          </div>
          <div class="p-4 rounded-2xl bg-gradient-to-br from-emerald-50 to-teal-50/60 border border-emerald-100 text-center">
            <span class="text-xs text-slate-500 font-bold block mb-1">晚高峰平均丢包率</span>
            <span class="text-2xl font-black text-emerald-700">{packetLoss}</span>
            <span class="text-[11px] text-slate-400 block mt-1">4K起播缓冲约 {yt4kBuffer}</span>
          </div>
        </div>

        <div class="bg-slate-50 rounded-2xl p-4 sm:p-5 border border-slate-100 text-xs sm:text-sm text-slate-600 leading-relaxed">
          <strong>💡 测速工程师简评：</strong>{airport.name} 的线路架构为 <strong>{airport.lineType}</strong>，在连续大文件多线程并发压测下，速率曲线平缓稳定，无突发大幅掉速。YouTube 4K 超高清视频切换拖拽几乎无缓冲转圈，外服联机对局延迟平稳无跳 Ping，综合性能处于同价位梯子前列。
        </div>
      </div>

      <!-- Plans & Pricing Section -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm mb-8">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900">
              {airport.name} 最新套餐规格与价格详情表
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              以下数据均采自官方公开订购系统，支持灵活月付与长周期折扣：
            </p>
          </div>
          {airport.coupon && (
            <span class="hidden sm:inline-flex items-center gap-1 text-xs font-bold text-amber-700 bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-200">
              结账输入优惠码 <strong class="text-amber-900 font-mono">{airport.coupon}</strong>
            </span>
          )}
        </div>

        {airport.plans && airport.plans.length > 0 ? (
          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="min-w-full divide-y divide-slate-200 text-left text-xs sm:text-sm">
              <thead class="bg-slate-50 text-slate-700 font-bold">
                <tr>
                  <th class="py-3.5 px-4">套餐名称</th>
                  <th class="py-3.5 px-4">标称价格</th>
                  <th class="py-3.5 px-4">周期</th>
                  <th class="py-3.5 px-4">月可用流量</th>
                  <th class="py-3.5 px-4">单GB折算单价</th>
                  <th class="py-3.5 px-4">方案特性说明</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-slate-600">
                {airport.plans.map(p => (
                  <tr class="hover:bg-blue-50/40 transition-colors">
                    <td class="py-3.5 px-4 font-bold text-slate-900">{p.name}</td>
                    <td class="py-3.5 px-4 font-bold text-blue-600">¥{p.price}</td>
                    <td class="py-3.5 px-4">{p.cycle}</td>
                    <td class="py-3.5 px-4 font-bold">{p.bandwidthGB} GB</td>
                    <td class="py-3.5 px-4 text-emerald-600 font-bold">¥{(p.pricePerGB || (p.price / p.bandwidthGB)).toFixed(3)} /GB</td>
                    <td class="py-3.5 px-4 text-slate-500 text-xs">{p.note || '高可用专线流量'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="text-slate-500 text-sm">起步套餐价格为 ¥{airport.startingPrice} / {airport.billingCycle || '月'}，具体方案请前往官方控制台查阅。</p>
        )}
      </div>

      <!-- Strengths vs Disadvantages -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <!-- Advantages -->
        <div class="bg-white rounded-3xl border border-emerald-200 p-6 sm:p-8 shadow-sm">
          <div class="flex items-center gap-2 text-emerald-700 font-black text-lg mb-4">
            <span class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-sm">✓</span>
            <h3>核心优势亮点分析</h3>
          </div>
          <ul class="space-y-3 text-xs sm:text-sm text-slate-600">
            {airport.advantages && airport.advantages.map(adv => (
              <li class="flex items-start gap-2.5">
                <span class="text-emerald-500 font-bold">✔</span>
                <span>{adv}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Disadvantages -->
        <div class="bg-white rounded-3xl border border-rose-200 p-6 sm:p-8 shadow-sm">
          <div class="flex items-center gap-2 text-rose-700 font-black text-lg mb-4">
            <span class="w-8 h-8 rounded-full bg-rose-100 flex items-center justify-center text-sm">✕</span>
            <h3>注意事项与局限性</h3>
          </div>
          <ul class="space-y-3 text-xs sm:text-sm text-slate-600">
            {airport.disadvantages && airport.disadvantages.map(dis => (
              <li class="flex items-start gap-2.5">
                <span class="text-rose-400 font-bold">✘</span>
                <span>{dis}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Protocol & Region Unlock Grid -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm mb-8 space-y-6">
        <div>
          <h3 class="text-lg font-black text-slate-900 mb-3">
            🌐 节点部署区域与支持网络协议
          </h3>
          <div class="flex flex-wrap gap-2 mb-4">
            {airport.protocols && airport.protocols.map(pt => (
              <span class="px-3 py-1 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200">
                协议：{pt}
              </span>
            ))}
            {airport.regions && airport.regions.map(rg => (
              <span class="px-3 py-1 rounded-xl text-xs font-bold bg-blue-50 text-blue-700 border border-blue-100">
                地区：{rg}
              </span>
            ))}
          </div>
          <p class="text-xs text-slate-500">
            兼容主流客户端：Clash Verge Rev、Clash for Windows、Shadowrocket (小火箭)、Sing-box、V2rayN、Surge 及 Loon。
          </p>
        </div>

        <div class="border-t border-slate-100 pt-6">
          <h3 class="text-lg font-black text-slate-900 mb-3">
            🤖 AI 与 4K 流媒体解锁实测表现
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-2xl bg-purple-50/60 border border-purple-100">
              <div class="text-xs font-bold text-purple-700 mb-2">AI 生产力工具适配</div>
              <div class="flex flex-wrap gap-1.5">
                {airport.aiSupport && airport.aiSupport.map(ai => (
                  <span class="px-2 py-0.5 rounded-md text-xs font-bold bg-white text-purple-800 shadow-xs border border-purple-200">
                    {ai} ✓
                  </span>
                ))}
              </div>
            </div>
            <div class="p-4 rounded-2xl bg-cyan-50/60 border border-cyan-100">
              <div class="text-xs font-bold text-cyan-700 mb-2">4K 超清流媒体解锁</div>
              <div class="flex flex-wrap gap-1.5">
                {airport.streamingSupport && airport.streamingSupport.map(str => (
                  <span class="px-2 py-0.5 rounded-md text-xs font-bold bg-white text-cyan-800 shadow-xs border border-cyan-200">
                    {str} ✓
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-100 pt-6">
          <h3 class="text-lg font-black text-slate-900 mb-2">
            🎯 适合人群定位
          </h3>
          <div class="flex flex-wrap gap-2">
            {airport.suitableFor && airport.suitableFor.map(s => (
              <span class="px-3 py-1 rounded-xl text-xs font-bold bg-slate-50 text-slate-700 border border-slate-200">
                {s}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Verdict Banner & CTA -->
      <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-3xl p-8 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 mb-12">
        <div class="max-w-xl">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-200">
            十代梯子实验室 · 最终编辑结论
          </span>
          <h3 class="text-2xl font-black mt-1 mb-2">
            {airport.name}：值得购买吗？
          </h3>
          <p class="text-xs sm:text-sm text-blue-100 leading-relaxed">
            综合其起步月付（¥{airport.startingPrice}/{airport.billingCycle || '月'}，享{bandwidthGB}GB高速流量）、{airport.lineType}网络稳定性与晚高峰实测速度，{airport.name} 在其定位层级上具备良好的实用价值。建议初次使用时优先按月付费体验。
          </p>
        </div>

        <a
          href={airport.affiliateUrl || airport.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-8 py-4 rounded-xl font-black text-sm text-blue-900 bg-white hover:bg-amber-300 shadow-lg transition-all"
        >
          立即前往官网选购体验 🚀
        </a>
      </div>

      <!-- Cross-Links & Navigation -->
      <div class="flex items-center justify-between text-xs sm:text-sm font-bold text-blue-600 border-t border-slate-200 pt-6">
        <a href="/review/" class="hover:underline flex items-center gap-1">
          &larr; 返回所有 14 家机场评测中心
        </a>
        <a href="/compare/" class="hover:underline flex items-center gap-1">
          进入横向对比工具 &rarr;
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
