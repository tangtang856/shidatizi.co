        </a>
      </div>
    </div>
  </section>

  <!-- Section 8: 常见问题解答 (FAQ) -->
  <section class="py-12 bg-slate-50 border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          常见问题解答 (FAQ)
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-2">
          针对翻墙机场选型、专线协议、单价核算与客户端使用的核心疑问解答：
        </p>
      </div>

      <div class="space-y-4">
        {faqItems.map((item) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
            <h3 class="font-bold text-sm sm:text-base text-slate-900 mb-2 flex items-start gap-2">
              <span class="text-blue-600 font-black">Q:</span>
              <span>{item.q}</span>
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed pl-5">
              {item.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
