---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allBlogs, allAirports } from '../../data/index.js';

export function getStaticPaths() {
  return allBlogs.map(blog => ({
    params: { slug: blog.slug },
    props: { blog }
  }));
}

const { blog } = Astro.props;

// Clean up any legacy relative html links to modern clean URLs
const cleanBody = (blog.body || '')
  .replace(/\.\.\/\.\.\/([a-zA-Z0-9_\-\/]+)\/index\.html/g, '/$1/')
  .replace(/\.\.\/([a-zA-Z0-9_\-\/]+)\/index\.html/g, '/$1/');

// Related articles from same category or fallback
const relatedArticles = allBlogs
  .filter(b => b.slug !== blog.slug && (b.category === blog.category || !blog.category))
  .slice(0, 4);

// Top airports for contextual recommendation
const topAirports = allAirports.slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": blog.h1,
  "description": blog.metaDesc,
  "datePublished": blog.date || "2026-03-01",
  "dateModified": blog.date || "2026-03-01",
  "author": {
    "@type": "Organization",
    "name": "十代梯子技术研究中心"
  },
  "publisher": {
    "@type": "Organization",
    "name": "十代梯子 · shidatizi.co"
  }
};
---

<BaseLayout
  title={blog.title}
  description={blog.metaDesc}
  keywords={blog.keywords}
  breadcrumbs={[
    { name: "深度资讯文章", href: "/blog/" },
    { name: blog.h1 }
  ]}
  schema={articleSchema}
>
  <div class="py-10 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Article Header -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm mb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-3">
          <span class="px-2.5 py-1 rounded-full font-bold bg-blue-100 text-blue-700">
            {blog.category || '深度专题'}
          </span>
          <span>📅 发布于：{blog.date || '2026-03-01'}</span>
          <span>⏱️ 阅读耗时：{blog.readTime || '6 分钟'}</span>
          <span class="text-emerald-600 font-bold">✓ 原创技术审计</span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-snug mb-4">
          {blog.h1}
        </h1>

        <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 text-xs sm:text-sm text-slate-600 leading-relaxed">
          <strong>导读摘要：</strong>{blog.metaDesc}
        </div>
      </div>

      <!-- Contextual Airport Banner -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl border border-blue-200 p-4 sm:p-5 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-bold text-blue-700 uppercase tracking-wider block mb-0.5">🚀 实测专线推荐</span>
          <div class="text-xs sm:text-sm font-bold text-slate-900">需要高速稳定且不过公网的内网专线节点？推荐使用：</div>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          {topAirports.map(a => (
            <a
              href={a.affiliateUrl || a.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-blue-600 border border-blue-200 hover:bg-blue-600 hover:text-white transition-all shadow-xs"
            >
              {a.name} (¥{a.startingPrice}/月) 🚀
            </a>
          ))}
        </div>
      </div>

      <!-- Article Main Body -->
      <article class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm mb-8 prose prose-slate max-w-none prose-headings:font-black prose-headings:text-slate-900 prose-a:text-blue-600 hover:prose-a:underline prose-code:text-blue-600 prose-code:bg-blue-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-table:border-collapse prose-table:w-full prose-th:bg-slate-50 prose-th:p-3 prose-td:p-3 prose-td:border-b prose-td:border-slate-100">
        <div set:html={cleanBody} />
      </article>

      <!-- Related Articles -->
      {relatedArticles.length > 0 && (
        <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm mb-8">
          <h3 class="text-lg font-black text-slate-900 mb-4">
            📰 同类深度研报推荐
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedArticles.map(ra => (
              <a
                href={`/blog/${ra.slug}/`}
                class="p-4 rounded-xl bg-slate-50 hover:bg-blue-50/60 border border-slate-100 hover:border-blue-200 transition-all flex flex-col justify-between group"
              >
                <div>
                  <span class="text-[11px] font-bold text-blue-600 mb-1 block">{ra.category}</span>
                  <h4 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2">
                    {ra.h1}
                  </h4>
                </div>
                <span class="text-[11px] text-slate-400 mt-2 block">耗时 {ra.readTime || '5 分钟'} &rarr;</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Bottom Nav -->
      <div class="text-center">
        <a href="/blog/" class="text-xs sm:text-sm font-bold text-blue-600 hover:underline">
          &larr; 查看全站 100 篇深度研究专栏
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
