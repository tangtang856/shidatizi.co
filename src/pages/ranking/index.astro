---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RankingTable from '../../components/RankingTable.astro';
import { allAirports } from '../../data/index.js';

const rankingCards = [
  {
    title: "2026 年度综合权威榜",
    slug: "overall",
    desc: "全维度综合考量物理专线、晚高峰速率、SLA可用性与套餐定价，最具参考价值的一站式总榜单。",
    badge: "权威总榜",
    color: "blue",
    icon: "🏆"
  },
  {
    title: "性价比天梯天花板榜",
    slug: "value",
    desc: "按每GB实际可用单价严格折算排序，挖掘微风网络 (¥0.04/GB)、飞猫云等超高性价比方案。",
    badge: "省钱必看",
    color: "emerald",
    icon: "⚖️"
  },
  {
    title: "便宜平价低预算榜",
    slug: "budget",
    desc: "专为学生党与轻度网络需求打造，起步月费低至 ¥7 起，一杯奶茶钱畅享稳定海外网络。",
    badge: "极低门槛",
    color: "amber",
    icon: "💰"
  },
  {
    title: "物理专线稳定天梯榜",
    slug: "stable",
    desc: "针对外贸涉外办公、跨境电商与海外高频交易，优选 99.9% 严苛 SLA 纯 IPLC/IEPL 物理专线。",
    badge: "0丢包专线",
    color: "indigo",
    icon: "🛡️"
  }
];
---

<BaseLayout
  title="2026 翻墙机场排行榜中心 - 权威综合排行/性价比/低预算/专线天梯榜 - shidatizi.co"
  description="汇聚2026年度翻墙机场权威排行榜：涵盖综合权威榜、高性价比天梯榜、便宜低预算榜以及稳定优先IPLC专线排行榜，助您科学决策避坑。"
  keywords="机场排行榜, 翻墙机场排名, 梯子排行榜, 机场推荐, 性价比机场排行, 稳定专线排行"
  breadcrumbs={[{ name: "排行榜中心" }]}
>
  <div class="py-12 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Title -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 mb-3">
          📊 真实客观 · 全维度数据天梯
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          2026 翻墙机场权威多维排行榜中心
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          基于多台物理服务器于晚高峰 20:00~23:00 真实测速，综合骨干网络物理架构、单GB持有成本与SLA可用性综合评定，杜绝虚假好评。
        </p>
      </div>

      <!-- 4 Ranking Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
        {rankingCards.map((rc) => (
          <a
            href={`/ranking/${rc.slug}/`}
            class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:shadow-lg hover:border-blue-400 transition-all group"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-3xl">{rc.icon}</span>
                <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-700">
                  {rc.badge}
                </span>
              </div>
              <h2 class="text-base font-black text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
                {rc.title}
              </h2>
              <p class="text-xs text-slate-500 leading-relaxed mb-4">
                {rc.desc}
              </p>
            </div>
            <span class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 group-hover:translate-x-1 transition-transform">
              进入该维度榜单 &rarr;
            </span>
          </a>
        ))}
      </div>

      <!-- Overall Ranking Table -->
      <div class="mb-14">
        <RankingTable criteria="overall" />
      </div>

    </div>
  </div>
</BaseLayout>
