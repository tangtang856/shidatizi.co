---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allAirports } from '../../data/index.js';

export function getStaticPaths() {
  return allAirports.map(airport => ({
    params: { slug: airport.slug },
    props: { airport }
  }));
}

const { airport } = Astro.props;
---

<BaseLayout
  title={`${airport.name} 资料库档案与官网直达 - shidatizi.co`}
  description={`收录${airport.name}官方资料库档案。包含${airport.name}官方最新网址直达、优惠码、套餐价格、线路架构、客户端支持与实测评分。`}
  keywords={`${airport.name}, ${airport.name}官网, ${airport.name}节点, ${airport.name}怎么样, 翻墙机场档案`}
  breadcrumbs={[
    { name: "机场资料库", href: "/airport/" },
    { name: airport.name }
  ]}
>
  <div class="py-12 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Card -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b border-slate-100">
          <div>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-blue-100 text-blue-700 mb-2 inline-block">
              机场品牌收录档案
            </span>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900">
              {airport.name} 档案资料库
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              收录编号：#{airport.order} · 最后核验时间：{airport.lastVerified || '2026-03-01'}
            </p>
          </div>

          <div class="flex flex-col gap-2 shrink-0">
            <a
              href={airport.affiliateUrl || airport.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-xl font-bold text-sm text-white bg-blue-600 hover:bg-blue-700 shadow-md text-center transition-all"
            >
              官网最新地址直达 🚀
            </a>
            <a
              href={`/review/${airport.slug}/`}
              class="px-6 py-2 rounded-xl font-bold text-xs text-slate-700 bg-slate-100 hover:bg-slate-200 text-center transition-all"
            >
              查阅深度测速报告
            </a>
          </div>
        </div>

        <!-- Meta list -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 text-xs sm:text-sm text-slate-600">
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-slate-400 block text-xs">线路网络架构</span>
            <strong class="text-slate-900 text-sm">{airport.lineType}</strong>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-slate-400 block text-xs">起步价格</span>
            <strong class="text-blue-600 text-sm">¥{airport.startingPrice} / {airport.billingCycle || '月'}</strong>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-slate-400 block text-xs">服务可用率 (SLA)</span>
            <strong class="text-emerald-600 text-sm">{airport.sla}</strong>
          </div>
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
            <span class="text-slate-400 block text-xs">同时连接设备数</span>
            <strong class="text-slate-900 text-sm">{airport.deviceLimit || '3-5台'}</strong>
          </div>
        </div>

        {airport.coupon && (
          <div class="mt-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 flex items-center justify-between">
            <div class="text-xs sm:text-sm">
              <span class="font-bold">专属结账立减券：</span>
              <code class="font-mono bg-amber-100 px-2 py-0.5 rounded font-bold text-amber-950">{airport.coupon}</code>
            </div>
            <a
              href={airport.affiliateUrl || airport.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold bg-amber-600 text-white px-3 py-1.5 rounded-lg hover:bg-amber-700"
            >
              复制并前往官网使用
            </a>
          </div>
        )}
      </div>

      <!-- Quick Plans Summary -->
      {airport.plans && airport.plans.length > 0 && (
        <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm mb-8">
          <h2 class="text-lg font-black text-slate-900 mb-4">
            已核验的公开套餐方案
          </h2>
          <div class="space-y-3">
            {airport.plans.map(p => (
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs sm:text-sm">
                <div>
                  <div class="font-bold text-slate-900">{p.name}</div>
                  <div class="text-slate-500 text-xs mt-0.5">{p.note || '高质量专线流量'}</div>
                </div>
                <div class="flex items-center gap-4">
                  <div class="text-right">
                    <span class="font-black text-blue-600 text-base">¥{p.price}</span>
                    <span class="text-slate-400 text-xs"> / {p.cycle}</span>
                  </div>
                  <div class="text-right border-l border-slate-200 pl-4">
                    <span class="font-bold text-slate-700">{p.bandwidthGB} GB</span>
                    <span class="text-emerald-600 text-xs block">¥{(p.pricePerGB || (p.price / p.bandwidthGB)).toFixed(3)}/GB</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Bottom Nav -->
      <div class="text-center">
        <a href="/airport/" class="text-xs sm:text-sm font-bold text-blue-600 hover:underline">
          &larr; 查看全站 14 家机场数据库总目录
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
