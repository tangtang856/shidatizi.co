---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allAirports } from '../../data/index.js';
---

<BaseLayout
  title="翻墙机场资料库总目录 - 14家梯子品牌技术参数与档案 - shidatizi.co"
  description="全景收录14家翻墙机场品牌基础档案资料：包含官网直达、套餐价格、线路类型、可用率SLA、节点协议与优惠码信息。"
  keywords="机场资料库, 机场目录, 翻墙品牌, 梯子档案, 节点资料库"
  breadcrumbs={[{ name: "机场资料库" }]}
>
  <div class="py-12 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Title -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-800 mb-3">
          🗂️ 结构化档案库
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          翻墙机场官方资料库总目录
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          统一维护与核验的 14 家翻墙机场技术规格总览，提供客观公开的套餐数据与官方直达链接。
        </p>
      </div>

      <!-- Airports Directory Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {allAirports.map((airport) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:shadow-lg transition-all">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono font-bold text-slate-400">#{airport.order}</span>
                <span class="text-xs px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-medium">{airport.lineType}</span>
              </div>
              <h2 class="text-lg font-black text-slate-900 mb-2">
                <a href={`/airport/${airport.slug}/`} class="hover:text-blue-600 transition-colors">
                  {airport.name}
                </a>
              </h2>
              <p class="text-xs text-slate-500 mb-4 line-clamp-2">
                {airport.tagline || airport.description}
              </p>

              <div class="space-y-1.5 text-xs text-slate-600 border-t border-slate-100 pt-3 mb-4">
                <div class="flex justify-between">
                  <span class="text-slate-400">起步价格</span>
                  <span class="font-bold text-blue-600">¥{airport.startingPrice} / {airport.billingCycle || '月'}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-400">网络 SLA</span>
                  <span class="font-bold text-emerald-600">{airport.sla}</span>
                </div>
                {airport.coupon && (
                  <div class="flex justify-between">
                    <span class="text-slate-400">优惠码</span>
                    <span class="font-mono font-bold text-amber-700">{airport.coupon}</span>
                  </div>
                )}
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 pt-2">
              <a
                href={`/airport/${airport.slug}/`}
                class="text-center py-2 px-3 rounded-lg text-xs font-bold bg-slate-50 hover:bg-slate-100 text-slate-700 border border-slate-200 transition-colors"
              >
                查看档案
              </a>
              <a
                href={airport.affiliateUrl || airport.officialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-center py-2 px-3 rounded-lg text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white transition-colors"
              >
                官网直达
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>
