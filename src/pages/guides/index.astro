---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allGuides } from '../../data/index.js';

const categories = [
  '全部',
  'Windows',
  'Android',
  'iOS',
  'macOS',
  '路由器/网关',
  '浏览器/扩展',
  '电视/主机',
  '进阶与开发',
  '进阶排错'
];
---

<BaseLayout
  title="翻墙科学上网教程中心 - Windows/Android/iOS/Mac 客户端全平台 30 篇实操指南 - shidatizi.co"
  description="汇集30篇全平台翻墙与科学上网图文教程。涵盖Clash Verge Rev、Shadowrocket(小火箭)、Sing-box、v2rayN、Surge等客户端在Windows、安卓、苹果iOS、Mac与软路由上的配置指引与故障排查。"
  keywords="翻墙教程, 梯子教程, Clash教程, 小火箭配置, v2rayN教程, 科学上网指南, 机场节点导入"
  breadcrumbs={[{ name: "教程中心" }]}
>
  <div class="py-12 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Title -->
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700 mb-3">
          📖 30 篇图文实操全库
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          全平台翻墙科学上网使用教程中心
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          从零开始手把手教你配置电脑、手机、平板、软路由及家庭电视盒子的代理客户端。解决节点超时、分流冲突与游戏联机排错。
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-10" id="cat-tabs">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-cat={cat}
            class={`cat-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border transition-all ${
              idx === 0
                ? 'bg-blue-600 text-white border-blue-600 shadow-sm'
                : 'bg-white text-slate-700 border-slate-200 hover:bg-slate-100'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Guides Grid (30 items) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16" id="guides-grid">
        {allGuides.map((guide) => (
          <div
            data-category={guide.category}
            class="guide-card bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:shadow-lg hover:border-blue-300 transition-all group"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 group-hover:bg-blue-50 group-hover:text-blue-700 transition-colors">
                  {guide.category}
                </span>
                <span class="text-[11px] text-slate-400">
                  ⏱️ {guide.readTime || '6 分钟'}
                </span>
              </div>

              <h2 class="text-base sm:text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors mb-2 leading-snug">
                <a href={`/guides/${guide.slug}/`}>
                  {guide.h1}
                </a>
              </h2>

              <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed mb-4">
                {guide.metaDesc}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[11px] text-slate-400">📅 {guide.date || '2026-03-01'}</span>
              <a
                href={`/guides/${guide.slug}/`}
                class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 group-hover:translate-x-0.5 transition-transform"
              >
                阅读实操教程 &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>

  <script is:inline>
    const tabs = document.querySelectorAll('.cat-tab');
    const cards = document.querySelectorAll('.guide-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-cat');
        
        // update tab styles
        tabs.forEach(t => {
          if (t === tab) {
            t.className = 'cat-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border transition-all bg-blue-600 text-white border-blue-600 shadow-sm';
          } else {
            t.className = 'cat-tab px-4 py-2 rounded-xl text-xs sm:text-sm font-bold border transition-all bg-white text-slate-700 border-slate-200 hover:bg-slate-100';
          }
        });

        // filter cards
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === '全部' || cardCat === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
