---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="联系我们 - shidatizi.co 官方联络与商务合作通道"
  description="联系 shidatizi.co 评测团队。提供 Gmail 官方商务邮箱与 Telegram 在线客服直通通道，支持机场服务商资料核验申请、评测合作沟通及读者技术反馈。"
  keywords="联系十代梯子, 机场收录申请, 网站反馈, 商务合作, Telegram联系, Gmail联系"
  breadcrumbs={[{ name: "联系我们" }]}
>
  <div class="py-12 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm mb-8">
        <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-blue-100 text-blue-700 mb-3 inline-block">
          十代梯子 · 官方沟通与商务合作直通通道
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
          联系我们
        </h1>
        <p class="text-sm text-slate-500 mb-8 leading-relaxed">
          十代梯子实验室始终致力于为读者提供中立、严谨的翻墙网络测速与价格分析。无论是读者关于客户端配置的疑问、数据勘误，还是机场运营方申请新线路入库评测、商业合作洽谈，均可通过以下官方渠道与我们取得直接联系：
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
          <!-- Gmail Channel -->
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-red-300 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-xl bg-red-100 text-red-600 flex items-center justify-center text-sm font-bold shadow-xs">
                    ✉️
                  </div>
                  <strong class="text-base font-black text-slate-900">Gmail 官方商务邮箱</strong>
                </div>
                <span class="text-[11px] font-semibold text-slate-400">24小时内响应</span>
              </div>
              <p class="text-xs text-slate-600 mb-4 leading-relaxed">
                适用于正式商务合作、机场品牌入库申请、深度评测邀约及官方资料更新。请随信附带您的服务商官网与基本线路架构说明。
              </p>
            </div>
            <div class="pt-3 border-t border-slate-200/60">
              <div class="flex items-center justify-between gap-2 bg-white px-3 py-2 rounded-xl border border-slate-200 text-xs sm:text-sm font-mono text-slate-900 font-bold mb-3">
                <span class="truncate select-all">xintangtang888@gmail.com</span>
              </div>
              <div class="grid grid-cols-2 gap-2">
                <a
                  href="mailto:xintangtang888@gmail.com"
                  class="py-2 px-3 text-center text-xs font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl transition-colors shadow-xs"
                >
                  发送邮件 🚀
                </a>
                <button
                  type="button"
                  class="py-2 px-3 text-center text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors copy-btn"
                  data-copy="xintangtang888@gmail.com"
                >
                  复制邮箱 📋
                </button>
              </div>
            </div>
          </div>

          <!-- Telegram Channel -->
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-sky-300 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-xl bg-sky-100 text-sky-600 flex items-center justify-center text-sm font-bold shadow-xs">
                    ✈️
                  </div>
                  <strong class="text-base font-black text-slate-900">Telegram 官方客服直通</strong>
                </div>
                <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">在线支持</span>
              </div>
              <p class="text-xs text-slate-600 mb-4 leading-relaxed">
                适用于即时沟通、紧急网络故障排查、优惠券码验证以及快速商业洽谈。工作日专人实时值守跟进。
              </p>
            </div>
            <div class="pt-3 border-t border-slate-200/60">
              <div class="flex items-center justify-between gap-2 bg-white px-3 py-2 rounded-xl border border-slate-200 text-xs sm:text-sm font-mono text-sky-700 font-bold mb-3">
                <span class="truncate select-all">@xintangtang</span>
              </div>
              <div class="grid grid-cols-2 gap-2">
                <a
                  href="https://t.me/xintangtang"
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="py-2 px-3 text-center text-xs font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-xl transition-colors shadow-xs"
                >
                  直达 TG 🚀
                </a>
                <button
                  type="button"
                  class="py-2 px-3 text-center text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors copy-btn"
                  data-copy="@xintangtang"
                >
                  复制 ID 📋
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs sm:text-sm leading-relaxed">
          <strong class="font-bold block mb-1">🛡️ 十代梯子独立评测准则倡议：</strong>
          我们始终恪守技术中立、客观真实的实测原则。任何以赞助、付费为前提要求篡改晚高峰真实丢包数据、或要求干预排行榜客观顺序的请求，我们一律予以拒绝。技术数据为本，感谢所有用户的支持与信赖。
        </div>
      </div>

    </div>
  </div>

  <script>
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-copy');
        if (text) {
          navigator.clipboard.writeText(text).then(() => {
            const orig = btn.textContent;
            btn.textContent = '已复制！';
            setTimeout(() => { btn.textContent = orig; }, 2000);
          }).catch(() => {
            prompt('请复制：', text);
          });
        }
      });
    });
  </script>
</BaseLayout>
